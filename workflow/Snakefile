# =====================================================================
# Duplex sequencing Snakemake pipeline
# =====================================================================

import pandas as pd
from pathlib import Path

# ---------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------
configfile: "config/config.yaml"

RESULTS  = config["results_dir"]
REF      = config["reference"]["fasta"]
SNV_BED     = config["snv_bed"]

FGBIO = config["tools"]["fgbio_jar"]
PICARD = config["tools"]["picard_jar"]

# ---------------------------------------------------------------------
# Per-rule threads / RAM (RADT-OUILLE: 96 cores, 256 GB)
# ---------------------------------------------------------------------
# Server guidance: <= 80 threads and < 200 GB RAM in total at once;
# bwa scales to ~32 threads, samtools/Picard/fgbio to ~24.
# Snakemake enforces the totals when run with
#     --cores 80 --resources mem_mb=190000
# (split these between instances if several runs go at once).
#
#   threads : what Snakemake reserves for the job
#   mem_mb  : what Snakemake counts against --resources mem_mb
#             (Java: -Xmx is heap only, so mem_mb ~ Xmx + 20-25%)
#   xmx     : Java heap for fgbio / Picard / VarDict
#   samtools sort -m is PER THREAD (sort_threads x sort_mem in total).
#
# Any entry can be overridden in a config file under `resources:`.
DEFAULT_RESOURCES = {
    "fastqc":          {"threads": 2,  "mem_mb": 2000},
    "fastq_to_bam":    {"threads": 3,  "mem_mb": 6000,  "xmx": "4G"},   # single-threaded + async-io
    "align":           {"threads": 26, "mem_mb": 24000, "xmx": "4G",    # bwa + ZipperBams + template sort
                        "bwa_threads": 24, "sort_threads": 4, "sort_mem": "2G"},
    "insert_size":     {"threads": 1,  "mem_mb": 6000,  "xmx": "4G"},
    "group":           {"threads": 4,  "mem_mb": 20000, "xmx": "16G"},  # mostly single-threaded
    "consensus":       {"threads": 16, "mem_mb": 20000, "xmx": "16G"},  # slowest step, scales well
    "map_consensus":   {"threads": 16, "mem_mb": 12000, "xmx": "4G",
                        "bwa_threads": 14},
    "filter":          {"threads": 4,  "mem_mb": 12000, "xmx": "8G",    # filter (1) + name sort
                        "sort_threads": 3, "sort_mem": "1G"},
    "clip":            {"threads": 4,  "mem_mb": 8000,  "xmx": "4G",    # ClipBam (1) + coord sort
                        "sort_threads": 3, "sort_mem": "1G"},
    "vardict":         {"threads": 4,  "mem_mb": 10000, "xmx": "8G"},
    "annovar":         {"threads": 2,  "mem_mb": 4000},
    "small":           {"threads": 1,  "mem_mb": 2000},                 # flagstat, pileup, bgzip, query
}

def _merge_resources(defaults, overrides):
    merged = {k: dict(v) for k, v in defaults.items()}
    for k, v in (overrides or {}).items():
        merged.setdefault(k, {}).update(v)
    return merged

RES = _merge_resources(DEFAULT_RESOURCES, config.get("resources"))

# Extra JVM options for every Java call. Each JVM otherwise sizes its
# garbage-collector thread pool from all 96 cores.
JAVA_OPTS = config.get("java_opts", "-XX:ParallelGCThreads=2")

# Optional scratch directory (ideally a local disk) for sort temp files.
# Default: a TEMP folder inside each sample's results directory.
TMP_ROOT = config.get("tmp_dir") or ""

def tmp_dir(wildcards):
    if TMP_ROOT:
        return f"{TMP_ROOT}/{wildcards.sample_udi}"
    return RESULTS + f"/{wildcards.sample_udi}/TEMP"
ANNOVAR_annotate = config["tools"]["annovar_annotate"]
ANNOVAR_humandb = config["tools"]["annovar_humandb"]

CALL_MIN_SSCS    = config["consensus"]["call_min_reads_sscs"]     # permissive, e.g. 1
CALL_MIN_DUPLEX  = config["consensus"]["call_min_reads_duplex"]   # permissive, e.g. "1 1 0"
BASEQUALMIN      = config["consensus"]["base_qual_min"]
CONSQUALMIN      = config["consensus"]["cons_qual_min"]
MAXBASEERRORRATE = config["consensus"]["max_base_error_rate"]
CLIPBASES        = config["consensus"]["clip_bases"]
ALLFREQ          = config["variants"]["all_freq"]

# Filter settings to sweep: name -> {"duplex": "total AB BA", "sscs": N}
FILTER_SETTINGS = config["filter_settings"]
SETTINGS = list(FILTER_SETTINGS)
LAYERS   = ["SSCS", "DCS"]

# Optional: start from existing UMI-grouped BAMs (e.g. from the legacy shell pipeline)
# instead of re-running FASTQ -> grouping. Pattern may use {sample_udi} and {sample}.
EXISTING_GROUPED = config.get("existing_grouped_bam") or ""

# Optional: start from existing FastqToBam outputs (unmapped BAM with the UMI
# already in RX and the 5 UMI+skip bases removed), skipping FASTQ -> BAM.
# Pattern may use {sample_udi} and {sample}.
EXISTING_UNMAPPED = config.get("existing_unmapped_bam") or ""

# ----------------------------------------------------------------------
# Output directories
# ----------------------------------------------------------------------
# consensus called once, permissively:   {sample_udi}/consensus_permissive/
# filtered per setting:                  {sample_udi}/{setting}/{SSCS,DCS,Variants,Metrics}/
PERM_DIR = "/{sample_udi}/consensus_permissive"
SET_DIR  = "/{sample_udi}/{setting}"

wildcard_constraints:
    sample_udi = "[^/]+",
    setting    = "[0-9]+-[0-9]+-[0-9]+",
    layer      = "SSCS|DCS",

# ---------------------------------------------------------------------
# Sample sheet
# ---------------------------------------------------------------------
# Load the TSV into a pandas DataFrame indexed by sample_UDI.
# `drop=False` keeps sample_UDI as both the index AND a column,
# which is occasionally handy.
samples_df = (
    pd.read_csv(config["samples_tsv"], sep="\t", dtype=str, comment="#")
      .set_index("sample_udi", drop=False)
)

# The list of sample identifiers we'll iterate over with `expand()`.
SAMPLES = samples_df["sample_udi"].tolist()

# ---------------------------------------------------------------------
# Helper functions for accessing per-sample metadata inside rules
# ---------------------------------------------------------------------
# These are "input functions" — Snakemake calls them with a `wildcards`
# object and expects them to return a file path (or list of them).
# They let us look up per-sample info in the TSV at rule-execution time.

def get_fq1(wildcards):
    return samples_df.loc[wildcards.sample_udi, "fq1"]

def get_fq2(wildcards):
    return samples_df.loc[wildcards.sample_udi, "fq2"]

def get_sample_name(wildcards):
    return samples_df.loc[wildcards.sample_udi, "sample"]

def get_library_name(wildcards):
    return samples_df.loc[wildcards.sample_udi, "library"]

def grouped_bam(wildcards):
    """UMI-grouped BAM: either from this pipeline or an existing one (config)."""
    if EXISTING_GROUPED:
        return EXISTING_GROUPED.format(sample_udi=wildcards.sample_udi,
                                       sample=samples_df.loc[wildcards.sample_udi, "sample"])
    return RESULTS + f"/{wildcards.sample_udi}/{wildcards.sample_udi}_UMI_grouped.bam"

def unmapped_bam(wildcards):
    """Unmapped BAM with RX set: from fastq_to_bam, or an existing one (config)."""
    if EXISTING_UNMAPPED:
        return EXISTING_UNMAPPED.format(sample_udi=wildcards.sample_udi,
                                        sample=samples_df.loc[wildcards.sample_udi, "sample"])
    return RESULTS + f"/{wildcards.sample_udi}/{wildcards.sample_udi}_unmapped_bam.bam"

def filter_min_reads(wildcards):
    """--min-reads for FilterConsensusReads: 1 value for SSCS, 3 for DCS."""
    fs = FILTER_SETTINGS[wildcards.setting]
    return str(fs["sscs"]) if wildcards.layer == "SSCS" else str(fs["duplex"])

# SSCS filtering only depends on the SSCS min-reads value, so settings that
# share it (e.g. 3-2-1 and 2-1-1, both sscs: 1) give identical SSCS BAMs.
# The first setting with each value is filtered/clipped; the others get a
# symlink to its final BAM (see rule alias_duplicate_sscs).
SSCS_CANONICAL = {}     # setting -> setting whose SSCS BAM it reuses
_first_with_min = {}
for _s in SETTINGS:
    _m = str(FILTER_SETTINGS[_s]["sscs"])
    if _m in _first_with_min:
        SSCS_CANONICAL[_s] = _first_with_min[_m]
    else:
        _first_with_min[_m] = _s

# ---------------------------------------------------------------------
# Final targets
# ---------------------------------------------------------------------
# For the first working version we're aiming at the FastQC reports
# as the "final" outputs. As we add more rules, this list will grow
# (and eventually point at the grouped BAM, then the annotated TSVs).

PREPROCESSING_OUTPUTS = [
    expand(RESULTS + "/{sample_udi}/fastqc/{sample_udi}_fastqc.done", sample_udi=SAMPLES),
    expand(RESULTS + "/{sample_udi}/{sample_udi}_UMI_grouped.bam", sample_udi=SAMPLES),
    expand(RESULTS + "/{sample_udi}/Metrics_and_images/{sample_udi}_insert_size_metrics.txt", sample_udi=SAMPLES),
]

SWEEP_OUTPUTS = [
    expand(RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam",
           sample_udi=SAMPLES, setting=SETTINGS, layer=LAYERS),
    expand(RESULTS + SET_DIR + "/Metrics/{sample_udi}_{layer}_flagstat.txt",
           sample_udi=SAMPLES, setting=SETTINGS, layer=LAYERS),
    expand(RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.tsv",
           sample_udi=SAMPLES, setting=SETTINGS, layer=LAYERS),
    expand(RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_pileup.txt",
           sample_udi=SAMPLES, setting=SETTINGS, layer=LAYERS),
]

# When starting from existing grouped BAMs, don't ask for FASTQ-level outputs.
if EXISTING_GROUPED:
    FINAL_OUTPUTS = SWEEP_OUTPUTS
elif EXISTING_UNMAPPED:
    FINAL_OUTPUTS = SWEEP_OUTPUTS + PREPROCESSING_OUTPUTS[1:]   # no FASTQ, so no FastQC
else:
    FINAL_OUTPUTS = SWEEP_OUTPUTS + PREPROCESSING_OUTPUTS

rule all:
    input:
        FINAL_OUTPUTS



# ---------------------------------------------------------------------
# Rule: FastQC on raw FASTQs
# ---------------------------------------------------------------------
rule fastqc:
    input:
        fq1 = get_fq1,
        fq2 = get_fq2,
    output:
        # FastQC produces multiple files per input FASTQ with names derived
        # from the input filenames — and those derived names are hard to
        # predict from inside Snakemake. A clean trick is to `touch` a
        # sentinel file at the end of the rule and declare THAT as the
        # output. Snakemake tracks the sentinel; the real reports live
        # in the same directory.
        done = touch(RESULTS + "/{sample_udi}/fastqc/{sample_udi}_fastqc.done"),
    params:
        outdir = RESULTS + "/{sample_udi}/fastqc",
    threads: RES["fastqc"]["threads"]          # FastQC threads = files in parallel, so 2 is the max
    resources:
        mem_mb = RES["fastqc"]["mem_mb"],
    conda: "envs/fastqc.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        fastqc {input.fq1} {input.fq2} \
            --outdir {params.outdir} \
            --threads {threads} \
            --quiet
        """


# ---------------------------------------------------------------------
# Rule: FastqtoBam on raw FASTQs
# ---------------------------------------------------------------------

rule fastq_to_bam:
    input:
        fq1 = get_fq1,
        fq2 = get_fq2,
    output:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_unmapped_bam.bam",
    params:
        sample = get_sample_name,
        library = get_library_name,
        java_xmx = RES["fastq_to_bam"]["xmx"],
    threads: RES["fastq_to_bam"]["threads"]
    resources:
        mem_mb = RES["fastq_to_bam"]["mem_mb"],
    conda: "envs/fgbio.yaml"
    shell:
        """
        java -Xmx{params.java_xmx} {JAVA_OPTS} -jar {FGBIO} --compression 1 --async-io FastqToBam \
            --input {input.fq1} {input.fq2} \
            --read-structures 3M2S+T 3M2S+T \
            --umi-tag RX \
            --sample {params.sample} \
            --library {params.library} \
            --platform-unit FLOWCELL.LANE \
            --output {output.bam}
        """

# NOTE: there is deliberately no ExtractUmisFromBam step. FastqToBam with
# --read-structures 3M2S+T already writes the UMI to RX and removes the 5
# UMI+skip bases. Running ExtractUmisFromBam on its output (as this pipeline
# did up to tag backup/double-umi-extraction) removed a further 5 bases and
# overwrote RX with genomic bases 6-8 of each read.

# ---------------------------------------------------------------------
# Rule: BWA MEM alignment, ZipperBams and template-coordinate sort (one stream)
# ---------------------------------------------------------------------
# fgbio best practice: everything is piped, so no intermediate FASTQs or
# unsorted BAMs are written to disk.
#   -p          interleaved pairs from samtools fastq
#   -K 150000000 fixed batch size -> output identical whatever -t is
#   -Y          soft-clip supplementary alignments (as for the consensus reads)
# NOTE: -K/-Y were not used before, so alignments can differ very slightly
# from runs made with the old align_and_merge rule.

rule align_zipper_sort:
    input:
        unmapped = unmapped_bam,
    output:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_mapped_merged_sorted.bam",
    log:
        RESULTS + "/{sample_udi}/logs/align_merge.log",
    params:
        tmp_dir = tmp_dir,
        java_xmx = RES["align"]["xmx"],
        bwa_threads = RES["align"]["bwa_threads"],
        sort_threads = RES["align"]["sort_threads"],
        sort_mem = RES["align"]["sort_mem"],
    threads: RES["align"]["threads"]
    resources:
        mem_mb = RES["align"]["mem_mb"],
    conda: "envs/fgbio.yaml"
    shell:
        """
        mkdir -p {params.tmp_dir} $(dirname {log})
        (
        samtools fastq -n {input.unmapped} \
            | bwa mem -t {params.bwa_threads} -p -K 150000000 -Y {REF} - \
            | java -Xmx{params.java_xmx} {JAVA_OPTS} -jar {FGBIO} --compression 0 --async-io \
                --tmp-dir {params.tmp_dir} ZipperBams \
                --unmapped {input.unmapped} \
                --input /dev/stdin \
                --ref {REF} \
                --output /dev/stdout \
            | samtools sort --template-coordinate \
                -@ {params.sort_threads} -m {params.sort_mem} \
                -T {params.tmp_dir}/{wildcards.sample_udi}_tc_sort \
                -o {output.bam} -
        ) 2> {log}
        """

# ---------------------------------------------------------------------
# Rule: Picard collect insert size metrics
# ---------------------------------------------------------------------

rule insert_size_metrics:
    input:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_mapped_merged_sorted.bam",
    output:
        metrics = RESULTS + "/{sample_udi}/Metrics_and_images/{sample_udi}_insert_size_metrics.txt",
        histogram = RESULTS + "/{sample_udi}/Metrics_and_images/{sample_udi}_insert_size_histogram.pdf",
    params:
        outdir = RESULTS + "/{sample_udi}/Metrics_and_images",
        java_xmx = RES["insert_size"]["xmx"],
    threads: RES["insert_size"]["threads"]
    resources:
        mem_mb = RES["insert_size"]["mem_mb"],
    conda: "envs/picard.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        # explicit -Xmx: without it Java takes up to 1/4 of the server's RAM (~64 GB)
        java -Xmx{params.java_xmx} {JAVA_OPTS} -jar {PICARD} CollectInsertSizeMetrics \
            I={input.bam} \
            O={output.metrics} \
            H={output.histogram}
        """

# ---------------------------------------------------------------------
# Rule: Fgbio GroupReadsByUmi to group reads into families and generate UMI metrics
# ---------------------------------------------------------------------

rule group_reads_by_umi:
    input:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_mapped_merged_sorted.bam",
    output:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_UMI_grouped.bam",
        family_histogram = RESULTS + "/{sample_udi}/Metrics_and_images/{sample_udi}_family_size_histogram.txt",
        umi_metrics = RESULTS + "/{sample_udi}/Metrics_and_images/{sample_udi}_SSCS_UMI_metrics.txt",
    params:
        java_xmx = RES["group"]["xmx"],
        outdir = RESULTS + "/{sample_udi}/Metrics_and_images",
    threads: RES["group"]["threads"]
    resources:
        mem_mb = RES["group"]["mem_mb"],
    conda: "envs/fgbio.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        java -Xmx{params.java_xmx} {JAVA_OPTS} -jar {FGBIO} --compression 1 --async-io GroupReadsByUmi \
            --input {input.bam} \
            --strategy Paired \
            --edits 1 \
            --output {output.bam} \
            --family-size-histogram {output.family_histogram} \
            --grouping-metrics {output.umi_metrics} \
            --threads {threads}
        """

# =====================================================================
# Consensus calling — done ONCE, permissively
# =====================================================================
# Calling consensus is slow; filtering is fast. So we call with very
# permissive thresholds (SSCS: 1 read; DCS: "1 1 0") and apply the real
# family-size thresholds afterwards with FilterConsensusReads, once per
# entry in config["filter_settings"].

# ---------------------------------------------------------------------
# Rule: Fgbio CallMolecularConsensusReads (permissive) -> SSCS
# ---------------------------------------------------------------------

rule call_sscs_permissive:
    input:
        bam = grouped_bam,
    output:
        bam = RESULTS + PERM_DIR + "/{sample_udi}_SSCS_unmapped.bam",
    params:
        java_xmx = RES["consensus"]["xmx"],
        min_reads = CALL_MIN_SSCS,
        base_qual_min = BASEQUALMIN,
    threads: RES["consensus"]["threads"]
    resources:
        mem_mb = RES["consensus"]["mem_mb"],
    conda: "envs/fgbio.yaml"
    shell:
        """
        java -Xmx{params.java_xmx} {JAVA_OPTS} -jar {FGBIO} --compression 1 --async-io CallMolecularConsensusReads \
            --input {input.bam} \
            --output {output.bam} \
            --min-reads {params.min_reads} \
            --min-input-base-quality {params.base_qual_min} \
            --threads {threads}
        """

# ---------------------------------------------------------------------
# Rule: Fgbio CallDuplexConsensusReads (permissive) -> DCS
# ---------------------------------------------------------------------

rule call_dcs_permissive:
    input:
        bam = grouped_bam,
    output:
        bam = RESULTS + PERM_DIR + "/{sample_udi}_DCS_unmapped.bam",
    params:
        java_xmx = RES["consensus"]["xmx"],
        min_reads = CALL_MIN_DUPLEX,
        base_qual_min = BASEQUALMIN,
    threads: RES["consensus"]["threads"]
    resources:
        mem_mb = RES["consensus"]["mem_mb"],
    conda: "envs/fgbio.yaml"
    shell:
        """
        java -Xmx{params.java_xmx} {JAVA_OPTS} -jar {FGBIO} --compression 1 --async-io CallDuplexConsensusReads \
            --input {input.bam} \
            --output {output.bam} \
            --min-reads {params.min_reads} \
            --min-input-base-quality {params.base_qual_min} \
            --threads {threads}
        """

# ---------------------------------------------------------------------
# Rule: Map consensus reads and merge back tags (SSCS and DCS)
# ---------------------------------------------------------------------

rule map_merge_consensus:
    input:
        bam = RESULTS + PERM_DIR + "/{sample_udi}_{layer}_unmapped.bam",
    output:
        bam = RESULTS + PERM_DIR + "/{sample_udi}_{layer}_mapped.bam",
    params:
        java_xmx = RES["map_consensus"]["xmx"],
        bwa_threads = RES["map_consensus"]["bwa_threads"],
    threads: RES["map_consensus"]["threads"]
    resources:
        mem_mb = RES["map_consensus"]["mem_mb"],
    conda: "envs/fgbio.yaml"
    shell:
        """
        samtools fastq {input.bam} \
          | bwa mem -t {params.bwa_threads} -p -K 150000000 -Y {REF} - \
          | java -Xmx{params.java_xmx} {JAVA_OPTS} -jar {FGBIO} --compression 1 --async-io ZipperBams \
              --unmapped {input.bam} \
              --ref {REF} \
              --tags-to-reverse Consensus \
              --tags-to-revcomp Consensus \
              --output {output.bam}
        """

# =====================================================================
# Per filter setting (6-3-3, 4-2-2, 3-2-1, ...)
# =====================================================================

# ---------------------------------------------------------------------
# Rule: FilterConsensusReads at this setting, then sort by name for ClipBam
# ---------------------------------------------------------------------
# The name-sorted filtered BAM is only an intermediate for ClipBam, so it
# is marked temp() and deleted once the clipped/sorted BAM exists.

rule filter_sort_consensus:
    input:
        bam = RESULTS + PERM_DIR + "/{sample_udi}_{layer}_mapped.bam",
    output:
        bam = temp(RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered.bam"),
    params:
        java_xmx = RES["filter"]["xmx"],
        min_reads = filter_min_reads,          # SSCS: "3" ; DCS: "6 3 3" (unquoted -> 3 args)
        cons_qual_min = CONSQUALMIN,
        max_base_error_rate = MAXBASEERRORRATE,
        sort_threads = RES["filter"]["sort_threads"],
        sort_mem = RES["filter"]["sort_mem"],
        tmp_dir = tmp_dir,
    threads: RES["filter"]["threads"]
    resources:
        mem_mb = RES["filter"]["mem_mb"],
    conda: "envs/fgbio.yaml"
    shell:
        """
        mkdir -p {params.tmp_dir}
        java -Xmx{params.java_xmx} {JAVA_OPTS} -jar {FGBIO} --compression 0 FilterConsensusReads \
            --input {input.bam} \
            --output /dev/stdout \
            --ref {REF} \
            --min-reads {params.min_reads} \
            --min-base-quality {params.cons_qual_min} \
            --max-base-error-rate {params.max_base_error_rate} \
            | samtools sort -n -@ {params.sort_threads} -m {params.sort_mem} \
                -T {params.tmp_dir}/{wildcards.setting}_{wildcards.layer}_nsort \
                -o {output.bam} -
        """

# ---------------------------------------------------------------------
# Rule: Fgbio ClipBam piped into coordinate sort + index
# ---------------------------------------------------------------------
# ClipBam is single-threaded; streaming it into samtools sort avoids writing
# an uncompressed clipped BAM to disk. (Replaces the old clip_consensus +
# sort_index_consensus pair; the final file names are unchanged.)

rule clip_sort_consensus:
    input:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered.bam",
    output:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam",
        bai = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam.bai",
        metrics = RESULTS + SET_DIR + "/Metrics/{sample_udi}_{layer}_overlap_metrics.txt",
    params:
        java_xmx = RES["clip"]["xmx"],
        clip_bases = CLIPBASES,
        sort_threads = RES["clip"]["sort_threads"],
        sort_mem = RES["clip"]["sort_mem"],
        tmp_dir = tmp_dir,
    threads: RES["clip"]["threads"]
    resources:
        mem_mb = RES["clip"]["mem_mb"],
    conda: "envs/fgbio.yaml"
    shell:
        """
        mkdir -p {params.tmp_dir} $(dirname {output.metrics})
        java -Xmx{params.java_xmx} {JAVA_OPTS} -jar {FGBIO} --compression 0 ClipBam \
            --input {input.bam} \
            --output /dev/stdout \
            --ref {REF} \
            --clipping-mode Hard \
            --clip-overlapping-reads true \
            --read-one-five-prime {params.clip_bases} \
            --read-one-three-prime {params.clip_bases} \
            --read-two-five-prime {params.clip_bases} \
            --read-two-three-prime {params.clip_bases} \
            --metrics {output.metrics} \
            | samtools sort -@ {params.sort_threads} -m {params.sort_mem} \
                -T {params.tmp_dir}/{wildcards.setting}_{wildcards.layer}_csort \
                -o {output.bam} -
        samtools index -@ {params.sort_threads} {output.bam}
        """

# ---------------------------------------------------------------------
# Rule: reuse the SSCS BAM of an earlier setting with the same SSCS min-reads
# ---------------------------------------------------------------------
# e.g. 2-1-1 SSCS -> symlink to 3-2-1 SSCS. Only defined when such
# duplicates exist. Variant calling etc. still run per setting as before.

if SSCS_CANONICAL:
    import re as _re

    rule alias_duplicate_sscs:
        input:
            bam = lambda w: RESULTS + f"/{w.sample_udi}/{SSCS_CANONICAL[w.setting]}/SSCS/{w.sample_udi}_SSCS_mapped_filtered_clipped_sorted.bam",
            bai = lambda w: RESULTS + f"/{w.sample_udi}/{SSCS_CANONICAL[w.setting]}/SSCS/{w.sample_udi}_SSCS_mapped_filtered_clipped_sorted.bam.bai",
        output:
            bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam",
            bai = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam.bai",
        wildcard_constraints:
            setting = "|".join(_re.escape(s) for s in SSCS_CANONICAL),
            layer = "SSCS",
        params:
            canon = lambda w: SSCS_CANONICAL[w.setting],
        threads: 1
        resources:
            mem_mb = 100,
        shell:
            """
            mkdir -p $(dirname {output.bam})
            ln -sfn ../../{params.canon}/SSCS/$(basename {output.bam}) {output.bam}
            ln -sfn ../../{params.canon}/SSCS/$(basename {output.bai}) {output.bai}
            """

    ruleorder: alias_duplicate_sscs > clip_sort_consensus

# ---------------------------------------------------------------------
# Rule: flagstat for a quick read-count comparison
# ---------------------------------------------------------------------

rule flagstat_consensus:
    input:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam",
    output:
        txt = RESULTS + SET_DIR + "/Metrics/{sample_udi}_{layer}_flagstat.txt",
    threads: RES["small"]["threads"]
    resources:
        mem_mb = RES["small"]["mem_mb"],
    conda: "envs/fgbio.yaml"
    shell:
        "samtools flagstat {input.bam} > {output.txt}"

# ---------------------------------------------------------------------
# Rule: VardictJava
# ---------------------------------------------------------------------

rule call_variants:
    input:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam",
    output:
        vcf = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants.vcf.gz",
    params:
        outdir = RESULTS + SET_DIR + "/Variants",
        bed = SNV_BED,
        allfreq = ALLFREQ,
        java_xmx = RES["vardict"]["xmx"],
    threads: RES["vardict"]["threads"]
    resources:
        mem_mb = RES["vardict"]["mem_mb"],
    conda: "envs/vardict.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        # vardict-java's launcher reads JAVA_OPTS (explicit heap instead of the JVM default)
        export JAVA_OPTS="-Xmx{params.java_xmx} {JAVA_OPTS}"
        vardict-java \
            -G {REF} \
            -N {wildcards.sample_udi} \
            -b {input.bam} \
            -z 1 \
            -c 1 -S 2 -E 3 -g 4 \
            -f {params.allfreq} \
            -r 1 \
            -Q {BASEQUALMIN} \
            -q 0 \
            -o 0 \
            -k 0 \
            -y \
            -th {threads} \
            {params.bed} \
            | teststrandbias.R \
            | var2vcf_valid.pl -N {wildcards.sample_udi} -E -f {params.allfreq} \
            | bgzip -c > {output.vcf}
        """

# ---------------------------------------------------------------------
# Rule: ANNOVAR annotation (ANNOVAR installed manually, see README)
# ---------------------------------------------------------------------

rule annotate_variants:
    input:
        vcf = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants.vcf.gz",
    output:
        multianno_vcf = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.hg38_multianno.vcf",
    params:
        annovar_annotate = ANNOVAR_annotate,
        annovar_humandb = ANNOVAR_humandb,
        out_prefix = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated",
    threads: RES["annovar"]["threads"]
    resources:
        mem_mb = RES["annovar"]["mem_mb"],
        annovar = 1,     # cap concurrent ANNOVAR jobs (all read the same databases) with
                         # --resources annovar=4 on the command line
    shell:
        """
        perl {params.annovar_annotate} {input.vcf} {params.annovar_humandb}/ \
            -buildver hg38 \
            -vcfinput \
            -out {params.out_prefix} \
            -remove \
            -protocol refGene,cosmic102_coding,cosmic101_noncoding,exac03,gnomad_genome,clinvar_20240917 \
            -operation g,f,f,f,f,f \
            -nastring . \
            -thread {threads}
        """

rule compress_index_annotated_vcf:
    input:
        annotated_vcf = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.hg38_multianno.vcf",
    output:
        annotated_vcf_gz = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.hg38_multianno.vcf.gz",
        annotated_vcf_gz_tbi = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.hg38_multianno.vcf.gz.tbi",
    threads: RES["small"]["threads"]
    resources:
        mem_mb = RES["small"]["mem_mb"],
    conda: "envs/bcftools.yaml"
    shell:
        """
        bgzip -c {input.annotated_vcf} > {output.annotated_vcf_gz}
        tabix -p vcf {output.annotated_vcf_gz}
        """

rule create_annotated_tsv:
    input:
        annotated_vcf_gz = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.hg38_multianno.vcf.gz",
    output:
        tsv = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.tsv",
    threads: RES["small"]["threads"]
    resources:
        mem_mb = RES["small"]["mem_mb"],
    conda: "envs/bcftools.yaml"
    shell:
        """
        bcftools query --allow-undef-tags \
        -f '%CHROM\\t%POS\\t%REF\\t%ALT\\t%INFO/DP\\t%INFO/VD\\t%INFO/AF\\t%INFO/Func.refGene\\t%INFO/Gene.refGene\\t%INFO/ExonicFunc.refGene\\t%INFO/gnomAD_genome_ALL\\t%INFO/CLNSIG\\n' \
        {input.annotated_vcf_gz} \
        > {output.tsv}
        """

# ---------------------------------------------------------------------
# Rule: Samtools mpileup at panel positions
# ---------------------------------------------------------------------

rule create_pileup:
    input:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam",
    output:
        pileup = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_pileup.txt",
    params:
        snv_bed = SNV_BED,
    threads: RES["small"]["threads"]
    resources:
        mem_mb = RES["small"]["mem_mb"],
    conda: "envs/fgbio.yaml"
    shell:
        """
        samtools mpileup \
            -A \
            -q 0 \
            -Q 0 \
            -B \
            -a \
            -f {REF} \
            -d 1000000 \
            -l "{params.snv_bed}" \
            {input.bam} \
            > {output.pileup}
        """
