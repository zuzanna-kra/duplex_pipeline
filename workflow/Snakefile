# =====================================================================
# Duplex sequencing Snakemake pipeline
# =====================================================================

import pandas as pd
from pathlib import Path

# ---------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------
configfile: "config/config.yaml"

RESULTS  = config["results_dir"]
REF      = config["reference"]["fasta"]
THREADS  = config["threads"]
SNV_BED     = config["snv_bed"]

FGBIO = config["tools"]["fgbio_jar"]
JAVA_XMX = config["java_xmx"]
PICARD = config["tools"]["picard_jar"]
ANNOVAR_annotate = config["tools"]["annovar_annotate"]
ANNOVAR_humandb = config["tools"]["annovar_humandb"]

CALL_MIN_SSCS    = config["consensus"]["call_min_reads_sscs"]     # permissive, e.g. 1
CALL_MIN_DUPLEX  = config["consensus"]["call_min_reads_duplex"]   # permissive, e.g. "1 1 0"
BASEQUALMIN      = config["consensus"]["base_qual_min"]
CONSQUALMIN      = config["consensus"]["cons_qual_min"]
MAXBASEERRORRATE = config["consensus"]["max_base_error_rate"]
CLIPBASES        = config["consensus"]["clip_bases"]
ALLFREQ          = config["variants"]["all_freq"]

# Filter settings to sweep: name -> {"duplex": "total AB BA", "sscs": N}
FILTER_SETTINGS = config["filter_settings"]
SETTINGS = list(FILTER_SETTINGS)
LAYERS   = ["SSCS", "DCS"]

# Optional: start from existing UMI-grouped BAMs (e.g. from the legacy shell pipeline)
# instead of re-running FASTQ -> grouping. Pattern may use {sample_udi} and {sample}.
EXISTING_GROUPED = config.get("existing_grouped_bam") or ""

# ----------------------------------------------------------------------
# Output directories
# ----------------------------------------------------------------------
# consensus called once, permissively:   {sample_udi}/consensus_permissive/
# filtered per setting:                  {sample_udi}/{setting}/{SSCS,DCS,Variants,Metrics}/
PERM_DIR = "/{sample_udi}/consensus_permissive"
SET_DIR  = "/{sample_udi}/{setting}"

wildcard_constraints:
    sample_udi = "[^/]+",
    setting    = "[0-9]+-[0-9]+-[0-9]+",
    layer      = "SSCS|DCS",

# ---------------------------------------------------------------------
# Sample sheet
# ---------------------------------------------------------------------
# Load the TSV into a pandas DataFrame indexed by sample_UDI.
# `drop=False` keeps sample_UDI as both the index AND a column,
# which is occasionally handy.
samples_df = (
    pd.read_csv(config["samples_tsv"], sep="\t", dtype=str, comment="#")
      .set_index("sample_udi", drop=False)
)

# The list of sample identifiers we'll iterate over with `expand()`.
SAMPLES = samples_df["sample_udi"].tolist()

# ---------------------------------------------------------------------
# Helper functions for accessing per-sample metadata inside rules
# ---------------------------------------------------------------------
# These are "input functions" — Snakemake calls them with a `wildcards`
# object and expects them to return a file path (or list of them).
# They let us look up per-sample info in the TSV at rule-execution time.

def get_fq1(wildcards):
    return samples_df.loc[wildcards.sample_udi, "fq1"]

def get_fq2(wildcards):
    return samples_df.loc[wildcards.sample_udi, "fq2"]

def get_sample_name(wildcards):
    return samples_df.loc[wildcards.sample_udi, "sample"]

def get_library_name(wildcards):
    return samples_df.loc[wildcards.sample_udi, "library"]

def grouped_bam(wildcards):
    """UMI-grouped BAM: either from this pipeline or an existing one (config)."""
    if EXISTING_GROUPED:
        return EXISTING_GROUPED.format(sample_udi=wildcards.sample_udi,
                                       sample=samples_df.loc[wildcards.sample_udi, "sample"])
    return RESULTS + f"/{wildcards.sample_udi}/{wildcards.sample_udi}_UMI_grouped.bam"

def filter_min_reads(wildcards):
    """--min-reads for FilterConsensusReads: 1 value for SSCS, 3 for DCS."""
    fs = FILTER_SETTINGS[wildcards.setting]
    return str(fs["sscs"]) if wildcards.layer == "SSCS" else str(fs["duplex"])

# ---------------------------------------------------------------------
# Final targets
# ---------------------------------------------------------------------
# For the first working version we're aiming at the FastQC reports
# as the "final" outputs. As we add more rules, this list will grow
# (and eventually point at the grouped BAM, then the annotated TSVs).

PREPROCESSING_OUTPUTS = [
    expand(RESULTS + "/{sample_udi}/fastqc/{sample_udi}_fastqc.done", sample_udi=SAMPLES),
    expand(RESULTS + "/{sample_udi}/{sample_udi}_UMI_grouped.bam", sample_udi=SAMPLES),
    expand(RESULTS + "/{sample_udi}/Metrics_and_images/{sample_udi}_insert_size_metrics.txt", sample_udi=SAMPLES),
]

SWEEP_OUTPUTS = [
    expand(RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam",
           sample_udi=SAMPLES, setting=SETTINGS, layer=LAYERS),
    expand(RESULTS + SET_DIR + "/Metrics/{sample_udi}_{layer}_flagstat.txt",
           sample_udi=SAMPLES, setting=SETTINGS, layer=LAYERS),
    expand(RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.tsv",
           sample_udi=SAMPLES, setting=SETTINGS, layer=LAYERS),
    expand(RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_pileup.txt",
           sample_udi=SAMPLES, setting=SETTINGS, layer=LAYERS),
]

# When starting from existing grouped BAMs, don't ask for FASTQ-level outputs.
FINAL_OUTPUTS = SWEEP_OUTPUTS + ([] if EXISTING_GROUPED else PREPROCESSING_OUTPUTS)

rule all:
    input:
        FINAL_OUTPUTS



# ---------------------------------------------------------------------
# Rule: FastQC on raw FASTQs
# ---------------------------------------------------------------------
rule fastqc:
    input:
        fq1 = get_fq1,
        fq2 = get_fq2,
    output:
        # FastQC produces multiple files per input FASTQ with names derived
        # from the input filenames — and those derived names are hard to
        # predict from inside Snakemake. A clean trick is to `touch` a
        # sentinel file at the end of the rule and declare THAT as the
        # output. Snakemake tracks the sentinel; the real reports live
        # in the same directory.
        done = touch(RESULTS + "/{sample_udi}/fastqc/{sample_udi}_fastqc.done"),
    params:
        outdir = RESULTS + "/{sample_udi}/fastqc",
    threads: THREADS
    conda: "envs/fastqc.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        fastqc {input.fq1} {input.fq2} \
            --outdir {params.outdir} \
            --threads {threads} \
            --quiet
        """


# ---------------------------------------------------------------------
# Rule: FastqtoBam on raw FASTQs
# ---------------------------------------------------------------------

rule fastq_to_bam:
    input:
        fq1 = get_fq1,
        fq2 = get_fq2,
    output:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_unmapped_bam.bam",
    params:
        sample = get_sample_name,
        library = get_library_name,
        java_xmx = JAVA_XMX,
    threads: THREADS
    conda: "envs/fgbio.yaml"
    shell:
        """
        java -Xmx{params.java_xmx} -jar {FGBIO} --compression 1 --async-io FastqToBam \
            --input {input.fq1} {input.fq2} \
            --read-structures 3M2S+T 3M2S+T \
            --sample {params.sample} \
            --library {params.library} \
            --platform-unit FLOWCELL.LANE \
            --output {output.bam}
        """

# ---------------------------------------------------------------------
# Rule: Fgbio Extract UMIs from BAM
# ---------------------------------------------------------------------

rule extract_umis:
    input:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_unmapped_bam.bam",
    output:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_unmapped_bam_UMI.bam",
    params:
        java_xmx = JAVA_XMX,
        tmp_dir = RESULTS + "/{sample_udi}/TEMP",
    threads: THREADS
    conda: "envs/fgbio.yaml"
    shell:
        """
        mkdir -p {params.tmp_dir}
        java -Xmx{params.java_xmx} -jar {FGBIO} --tmp-dir {params.tmp_dir} \
            ExtractUmisFromBam \
            --input {input.bam} \
            --output {output.bam} \
            --read-structure 3M2S+T \
            --read-structure 3M2S+T \
            --molecular-index-tags ZA ZB \
            --single-tag RX
        """

# ---------------------------------------------------------------------
# Rule: BWA MEM alignment to reference
# ---------------------------------------------------------------------

rule align_and_merge:
    input:
        unmapped = RESULTS + "/{sample_udi}/{sample_udi}_unmapped_bam_UMI.bam",
    output:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_mapped_merged.bam",
    log:
        RESULTS + "/{sample_udi}/logs/align_merge.log",
    params:
        tmp_dir = RESULTS + "/{sample_udi}/TEMP",
        java_xmx = JAVA_XMX,
    threads: THREADS
    conda: "envs/fgbio.yaml"
    shell:
        """
        mkdir -p {params.tmp_dir} $(dirname {log})
        (
        samtools fastq -n \
            -1 {params.tmp_dir}/r1.fq.gz \
            -2 {params.tmp_dir}/r2.fq.gz \
            {input.unmapped}

        bwa mem -t {threads} {REF} \
            {params.tmp_dir}/r1.fq.gz \
            {params.tmp_dir}/r2.fq.gz \
            | samtools view -b -o {params.tmp_dir}/aligned.bam

        java -Xmx{params.java_xmx} -jar {FGBIO} --tmp-dir {params.tmp_dir} ZipperBams \
        --unmapped {input.unmapped} \
        --input {params.tmp_dir}/aligned.bam \
        --output {output.bam} \
        --ref {REF}
        ) 2> {log}
        """

# ---------------------------------------------------------------------
# Rule: Samtools sort merged BAM by coordinates for grouping
# ---------------------------------------------------------------------

rule sort_merged_bam:
    input:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_mapped_merged.bam",
    output:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_mapped_merged_sorted.bam",
    threads: THREADS
    conda: "envs/fgbio.yaml"
    shell:
        """
        samtools sort --template-coordinate -@ {threads} \
            -o {output.bam} {input.bam}
        """

# ---------------------------------------------------------------------
# Rule: Picard collect insert size metrics
# ---------------------------------------------------------------------

rule insert_size_metrics:
    input:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_mapped_merged_sorted.bam",
    output:
        metrics = RESULTS + "/{sample_udi}/Metrics_and_images/{sample_udi}_insert_size_metrics.txt",
        histogram = RESULTS + "/{sample_udi}/Metrics_and_images/{sample_udi}_insert_size_histogram.pdf",
    params:
        outdir = RESULTS + "/{sample_udi}/Metrics_and_images",
    conda: "envs/picard.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        java -jar {PICARD} CollectInsertSizeMetrics \
            I={input.bam} \
            O={output.metrics} \
            H={output.histogram}
        """

# ---------------------------------------------------------------------
# Rule: Fgbio GroupReadsByUmi to group reads into families and generate UMI metrics
# ---------------------------------------------------------------------

rule group_reads_by_umi:
    input:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_mapped_merged_sorted.bam",
    output:
        bam = RESULTS + "/{sample_udi}/{sample_udi}_UMI_grouped.bam",
        family_histogram = RESULTS + "/{sample_udi}/Metrics_and_images/{sample_udi}_family_size_histogram.txt",
        umi_metrics = RESULTS + "/{sample_udi}/Metrics_and_images/{sample_udi}_SSCS_UMI_metrics.txt",
    params:
        java_xmx = JAVA_XMX,
        outdir = RESULTS + "/{sample_udi}/Metrics_and_images",
    threads: THREADS
    conda: "envs/fgbio.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        java -Xmx{params.java_xmx} -jar {FGBIO} --compression 1 --async-io GroupReadsByUmi \
            --input {input.bam} \
            --strategy Paired \
            --edits 1 \
            --output {output.bam} \
            --family-size-histogram {output.family_histogram} \
            --grouping-metrics {output.umi_metrics} \
            --threads {threads}
        """

# =====================================================================
# Consensus calling — done ONCE, permissively
# =====================================================================
# Calling consensus is slow; filtering is fast. So we call with very
# permissive thresholds (SSCS: 1 read; DCS: "1 1 0") and apply the real
# family-size thresholds afterwards with FilterConsensusReads, once per
# entry in config["filter_settings"].

# ---------------------------------------------------------------------
# Rule: Fgbio CallMolecularConsensusReads (permissive) -> SSCS
# ---------------------------------------------------------------------

rule call_sscs_permissive:
    input:
        bam = grouped_bam,
    output:
        bam = RESULTS + PERM_DIR + "/{sample_udi}_SSCS_unmapped.bam",
    params:
        java_xmx = JAVA_XMX,
        min_reads = CALL_MIN_SSCS,
        base_qual_min = BASEQUALMIN,
    threads: THREADS
    conda: "envs/fgbio.yaml"
    shell:
        """
        java -Xmx{params.java_xmx} -jar {FGBIO} --compression 1 --async-io CallMolecularConsensusReads \
            --input {input.bam} \
            --output {output.bam} \
            --min-reads {params.min_reads} \
            --min-input-base-quality {params.base_qual_min} \
            --threads {threads}
        """

# ---------------------------------------------------------------------
# Rule: Fgbio CallDuplexConsensusReads (permissive) -> DCS
# ---------------------------------------------------------------------

rule call_dcs_permissive:
    input:
        bam = grouped_bam,
    output:
        bam = RESULTS + PERM_DIR + "/{sample_udi}_DCS_unmapped.bam",
    params:
        java_xmx = JAVA_XMX,
        min_reads = CALL_MIN_DUPLEX,
        base_qual_min = BASEQUALMIN,
    threads: THREADS
    conda: "envs/fgbio.yaml"
    shell:
        """
        java -Xmx{params.java_xmx} -jar {FGBIO} --compression 1 --async-io CallDuplexConsensusReads \
            --input {input.bam} \
            --output {output.bam} \
            --min-reads {params.min_reads} \
            --min-input-base-quality {params.base_qual_min} \
            --threads {threads}
        """

# ---------------------------------------------------------------------
# Rule: Map consensus reads and merge back tags (SSCS and DCS)
# ---------------------------------------------------------------------

rule map_merge_consensus:
    input:
        bam = RESULTS + PERM_DIR + "/{sample_udi}_{layer}_unmapped.bam",
    output:
        bam = RESULTS + PERM_DIR + "/{sample_udi}_{layer}_mapped.bam",
    params:
        java_xmx = JAVA_XMX,
    threads: THREADS
    conda: "envs/fgbio.yaml"
    shell:
        """
        samtools fastq {input.bam} \
          | bwa mem -t {threads} -p -K 150000000 -Y {REF} - \
          | java -Xmx{params.java_xmx} -jar {FGBIO} --compression 1 --async-io ZipperBams \
              --unmapped {input.bam} \
              --ref {REF} \
              --tags-to-reverse Consensus \
              --tags-to-revcomp Consensus \
              --output {output.bam}
        """

# =====================================================================
# Per filter setting (6-3-3, 4-2-2, 3-2-1, ...)
# =====================================================================

# ---------------------------------------------------------------------
# Rule: FilterConsensusReads at this setting, then sort by name for ClipBam
# ---------------------------------------------------------------------

rule filter_sort_consensus:
    input:
        bam = RESULTS + PERM_DIR + "/{sample_udi}_{layer}_mapped.bam",
    output:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered.bam",
    params:
        java_xmx = JAVA_XMX,
        min_reads = filter_min_reads,          # SSCS: "3" ; DCS: "6 3 3" (unquoted -> 3 args)
        cons_qual_min = CONSQUALMIN,
        max_base_error_rate = MAXBASEERRORRATE,
    threads: THREADS
    conda: "envs/fgbio.yaml"
    shell:
        """
        java -Xmx{params.java_xmx} -jar {FGBIO} --compression 0 FilterConsensusReads \
            --input {input.bam} \
            --output /dev/stdout \
            --ref {REF} \
            --min-reads {params.min_reads} \
            --min-base-quality {params.cons_qual_min} \
            --max-base-error-rate {params.max_base_error_rate} \
            | samtools sort -n --threads {threads} -o {output.bam} -
        """

# ---------------------------------------------------------------------
# Rule: Fgbio ClipBam
# ---------------------------------------------------------------------

rule clip_consensus:
    input:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered.bam",
    output:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped.bam",
        metrics = RESULTS + SET_DIR + "/Metrics/{sample_udi}_{layer}_overlap_metrics.txt",
    params:
        java_xmx = JAVA_XMX,
        clip_bases = CLIPBASES,
    threads: THREADS
    conda: "envs/fgbio.yaml"
    shell:
        """
        java -Xmx{params.java_xmx} -jar {FGBIO} --compression 0 ClipBam \
        --input {input.bam} \
        --output {output.bam} \
        --ref {REF} \
        --clipping-mode Hard \
        --clip-overlapping-reads true \
        --read-one-five-prime {params.clip_bases} \
        --read-one-three-prime {params.clip_bases} \
        --read-two-five-prime {params.clip_bases} \
        --read-two-three-prime {params.clip_bases} \
        --metrics {output.metrics}
        """

# ---------------------------------------------------------------------
# Rule: Samtools sort + index; flagstat for a quick read-count comparison
# ---------------------------------------------------------------------

rule sort_index_consensus:
    input:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped.bam",
    output:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam",
        bai = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam.bai",
    threads: THREADS
    conda: "envs/fgbio.yaml"
    shell:
        """
        samtools sort -@ {threads} -o {output.bam} {input.bam}
        samtools index {output.bam}
        """

rule flagstat_consensus:
    input:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam",
    output:
        txt = RESULTS + SET_DIR + "/Metrics/{sample_udi}_{layer}_flagstat.txt",
    conda: "envs/fgbio.yaml"
    shell:
        "samtools flagstat {input.bam} > {output.txt}"

# ---------------------------------------------------------------------
# Rule: VardictJava
# ---------------------------------------------------------------------

rule call_variants:
    input:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam",
    output:
        vcf = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants.vcf.gz",
    params:
        outdir = RESULTS + SET_DIR + "/Variants",
        bed = SNV_BED,
        allfreq = ALLFREQ,
    threads: THREADS
    conda: "envs/vardict.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        vardict-java \
            -G {REF} \
            -N {wildcards.sample_udi} \
            -b {input.bam} \
            -z 1 \
            -c 1 -S 2 -E 3 -g 4 \
            -f {params.allfreq} \
            -r 1 \
            -Q {BASEQUALMIN} \
            -q 0 \
            -o 0 \
            -k 0 \
            -y \
            -th {threads} \
            {params.bed} \
            | teststrandbias.R \
            | var2vcf_valid.pl -N {wildcards.sample_udi} -E -f {params.allfreq} \
            | bgzip -c > {output.vcf}
        """

# ---------------------------------------------------------------------
# Rule: ANNOVAR annotation (ANNOVAR installed manually, see README)
# ---------------------------------------------------------------------

rule annotate_variants:
    input:
        vcf = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants.vcf.gz",
    output:
        multianno_vcf = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.hg38_multianno.vcf",
    params:
        annovar_annotate = ANNOVAR_annotate,
        annovar_humandb = ANNOVAR_humandb,
        out_prefix = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated",
    threads: THREADS
    shell:
        """
        perl {params.annovar_annotate} {input.vcf} {params.annovar_humandb}/ \
            -buildver hg38 \
            -vcfinput \
            -out {params.out_prefix} \
            -remove \
            -protocol refGene,cosmic102_coding,cosmic101_noncoding,exac03,gnomad_genome,clinvar_20240917 \
            -operation g,f,f,f,f,f \
            -nastring . \
            -thread {threads}
        """

rule compress_index_annotated_vcf:
    input:
        annotated_vcf = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.hg38_multianno.vcf",
    output:
        annotated_vcf_gz = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.hg38_multianno.vcf.gz",
        annotated_vcf_gz_tbi = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.hg38_multianno.vcf.gz.tbi",
    conda: "envs/bcftools.yaml"
    shell:
        """
        bgzip -c {input.annotated_vcf} > {output.annotated_vcf_gz}
        tabix -p vcf {output.annotated_vcf_gz}
        """

rule create_annotated_tsv:
    input:
        annotated_vcf_gz = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.hg38_multianno.vcf.gz",
    output:
        tsv = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_variants_annotated.tsv",
    conda: "envs/bcftools.yaml"
    shell:
        """
        bcftools query --allow-undef-tags \
        -f '%CHROM\\t%POS\\t%REF\\t%ALT\\t%INFO/DP\\t%INFO/VD\\t%INFO/AF\\t%INFO/Func.refGene\\t%INFO/Gene.refGene\\t%INFO/ExonicFunc.refGene\\t%INFO/gnomAD_genome_ALL\\t%INFO/CLNSIG\\n' \
        {input.annotated_vcf_gz} \
        > {output.tsv}
        """

# ---------------------------------------------------------------------
# Rule: Samtools mpileup at panel positions
# ---------------------------------------------------------------------

rule create_pileup:
    input:
        bam = RESULTS + SET_DIR + "/{layer}/{sample_udi}_{layer}_mapped_filtered_clipped_sorted.bam",
    output:
        pileup = RESULTS + SET_DIR + "/Variants/{sample_udi}_{layer}_pileup.txt",
    params:
        snv_bed = SNV_BED,
    conda: "envs/fgbio.yaml"
    shell:
        """
        samtools mpileup \
            -A \
            -q 0 \
            -Q 0 \
            -B \
            -a \
            -f {REF} \
            -d 1000000 \
            -l "{params.snv_bed}" \
            {input.bam} \
            > {output.pileup}
        """
